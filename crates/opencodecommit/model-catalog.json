{
  "assistedBy": {
    "harnesses": [
      "Codex",
      "Claude Code",
      "GitHub Copilot",
      "Codex-minimal",
      "OpenCode",
      "Cursor",
      "Antigravity",
      "Grok Build"
    ],
    "models": [
      "claude-fable-5-1",
      "claude-opus-5",
      "claude-sonnet-5",
      "gpt-6-astra",
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna",
      "grok-build",
      "kimi-k2.6",
      "gemini-3.1-pro-preview",
      "composer-2.5",
      "big-pickle",
      "grok-4.3",
      "deepseek-v4-pro"
    ],
    "quick": [
      {
        "label": "Astra",
        "agent": "Codex",
        "model": "gpt-6-astra",
        "versionCommand": "codex -V",
        "versionPattern": "codex-cli (?<version>\\S+)"
      },
      {
        "label": "Sol",
        "agent": "Codex",
        "model": "gpt-5.6-sol",
        "versionCommand": "codex -V",
        "versionPattern": "codex-cli (?<version>\\S+)"
      },
      {
        "label": "Fable",
        "agent": "Claude Code",
        "model": "claude-fable-5-1",
        "versionCommand": "claude -v",
        "versionPattern": "(?<version>\\S+) \\(Claude Code\\)"
      },
      {
        "label": "Opus",
        "agent": "Claude Code",
        "model": "claude-opus-5",
        "versionCommand": "claude -v",
        "versionPattern": "(?<version>\\S+) \\(Claude Code\\)"
      },
      {
        "label": "Build Grok",
        "agent": "Grok Build",
        "model": "grok-build",
        "versionCommand": "grok --version",
        "versionPattern": "grok (?<version>\\S+)"
      }
    ]
  },
  "backendDefaults": {
    "opencode": {
      "commit_model": "gpt-5.6-terra",
      "pr_model": "gpt-5.6-sol",
      "cheap_model": "gpt-5.6-luna"
    },
    "claude": {
      "commit_model": "claude-sonnet-5",
      "pr_model": "claude-opus-5",
      "cheap_model": "claude-haiku-4-5"
    },
    "codex": {
      "commit_model": "gpt-5.6-terra",
      "pr_model": "gpt-5.6-sol",
      "cheap_model": "gpt-5.6-luna"
    },
    "agy": {
      "commit_model": "Gemini 3.5 Flash (Low)",
      "pr_model": "Gemini 3.1 Pro (High)",
      "cheap_model": "Gemini 3.5 Flash (Low)"
    },
    "grok": {
      "commit_model": "grok-build",
      "pr_model": "grok-build",
      "cheap_model": "grok-build"
    }
  }
}
